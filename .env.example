# GEMINI_API_KEY: Optional API key for Gemini models (if server-side AI features are enabled).
# Automatically injected at runtime in managed cloud environments or configured locally.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, callbacks, and endpoints.
APP_URL="http://localhost:3000"
